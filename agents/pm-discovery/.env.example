# ── OpenRouter (Free LLM) ────────────────────────────────────────────────────
# Get your free API key at: https://openrouter.ai/
# Free models available — no credit card required for free tier
OPENROUTER_API_KEY=sk-or-v1-...

# Model to use:
#   deepseek/deepseek-v4-flash               ← recommended (best quality, $0.006/run, 1M context)
#   mistralai/mistral-nemo                    ← budget option ($0.0008/run, nearly same quality)
#   qwen/qwen3-14b                            ← good middle ground ($0.004/run)
#   mistralai/mistral-small-24b-instruct-2501 ← reliable fallback ($0.002/run)
#   google/gemma-4-31b-it:free                ← free but rate-limited
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# ── Confluence ───────────────────────────────────────────────────────────────
# Your Atlassian domain (no trailing slash)
CONFLUENCE_BASE_URL=https://yourcompany.atlassian.net

# Your Atlassian account email
CONFLUENCE_EMAIL=you@yourcompany.com

# Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-api-token-here

# The space key where documents will be published
# Found in Confluence: Space Settings → Space Details → Space Key
CONFLUENCE_SPACE_KEY=YOUR_SPACE_KEY

# The Confluence page ID of "Assistant PM — Discovery"
# Found in the page URL: /pages/XXXXXXXXX/
CONFLUENCE_PARENT_PAGE_ID=YOUR_PARENT_PAGE_ID

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to "true" to see full error stack traces
DEBUG=false
